# ==========================================
# MEDICAL REPORT ASSISTANCE SYSTEM - ENV CONFIG
# ==========================================

# Application
APP_NAME="Medical Report Understanding & Patient Assistance System"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=college_demo_jwt_secret_key_medical_assistance_2026

# Database (Default: SQLite for zero-config local run; Supports PostgreSQL)
# PostgreSQL example: postgresql+psycopg2://medical_user:password@localhost:5432/medical_app
DATABASE_URL=sqlite:///./medical_app.db

# Storage (Local Private Storage or Supabase Storage adapter)
STORAGE_BACKEND=local
UPLOAD_DIR=./backend/storage/private_uploads
MAX_UPLOAD_SIZE_MB=15
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

# AI / LLM Configuration
# Options: 'gemini', 'ollama', 'openai', or 'deterministic'
AI_PROVIDER=deterministic
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
ACCESS_TOKEN_EXPIRE_MINUTES=60
